{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Companion: API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Companion: start both (script)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/start_companion.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Companion: API + Web",
      "configurations": ["Companion: API"],
      "preLaunchTask": "Companion: Web",
      "stopAll": true
    }
  ]
}
